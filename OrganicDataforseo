// ==========================================================
// AUTOMATION: BATCH ORCHESTRATION FOR ORGANIC
// ==========================================================

function startOrganicAutomation() {
  const props = PropertiesService.getScriptProperties();

  const triggers = ScriptApp.getProjectTriggers().filter(function (t) {
    return t.getHandlerFunction() === ORGANIC_TRIGGER_HANDLER;
  });

  const runningFlag = props.getProperty('organicRunning') === 'true';

  // case 1: flag + trigger → genuinely running
  if (runningFlag && triggers.length > 0) {
    Logger.log('Organic automation already running (flag + trigger present).');
    return;
  }

  // case 2: flag true but no trigger → stale
  if (runningFlag && triggers.length === 0) {
    Logger.log('Stale organic automation state (flag=true, no trigger). Resetting.');
    props.setProperty('organicRunning', 'false');
  }

  props.setProperty('organicRunning', 'true');
  props.setProperty('organicBatchIndex', '0');
  props.setProperty('organicStartTime', new Date().toISOString());

  deleteOrganicTriggers();

  Logger.log('Starting organic automation (9 batches).');

  ScriptApp.newTrigger(ORGANIC_TRIGGER_HANDLER)
    .timeBased()
    .after(60 * 1000)  // start in 1 minute
    .create();
}


function runOrganicAutomation() {
  const props = PropertiesService.getScriptProperties();

  if (props.getProperty('organicRunning') !== 'true') {
    Logger.log('Organic automation flag off. Stopping and clearing triggers.');
    deleteOrganicTriggers();
    return;
  }

  const batches = ORGANIC_BATCH_CONFIG;
  let batchIndex = parseInt(props.getProperty('organicBatchIndex') || '0', 10);

  if (!batches || batchIndex >= batches.length) {
    Logger.log('All organic batches complete.');
    props.setProperty('organicRunning', 'false');
    props.setProperty('organicCompletedAt', new Date().toISOString());
    deleteOrganicTriggers();
    return;
  }

  const batch = batches[batchIndex];
  Logger.log(
    'Running ORGANIC batch ' +
    (batchIndex + 1) +
    '/' + batches.length +
    ' (rows ' + batch.start + '-' + batch.end + ')'
  );

  const clearSheet = (batchIndex === 0);

  try {
    fetchOrganicBatch(batch.start, batch.end, clearSheet);
  } catch (e) {
    Logger.log('Error in organic batch ' + (batchIndex + 1) + ': ' + e);
  }

  // increment batch index
  props.setProperty('organicBatchIndex', String(batchIndex + 1));

  // schedule next batch
  deleteOrganicTriggers();
  ScriptApp.newTrigger(ORGANIC_TRIGGER_HANDLER)
    .timeBased()
    .after(2 * 60 * 1000)   // 2 minutes between batches; tweak if needed
    .create();
}


function stopOrganicAutomation() {
  const props = PropertiesService.getScriptProperties();
  props.setProperty('organicRunning', 'false');
  props.setProperty('organicStoppedAt', new Date().toISOString());
  deleteOrganicTriggers();
  Logger.log('Organic automation stopped.');
}


function checkOrganicAutomationStatus() {
  const props = PropertiesService.getScriptProperties();
  const running = props.getProperty('organicRunning') === 'true';
  const batchIndex = parseInt(props.getProperty('organicBatchIndex') || '0', 10);
  const startTime = props.getProperty('organicStartTime');
  const completedAt = props.getProperty('organicCompletedAt');

  Logger.log('================ ORGANIC AUTOMATION STATUS ================');
  Logger.log('Running flag: ' + (running ? 'TRUE' : 'FALSE'));
  Logger.log('Batch index (0-based): ' + batchIndex);

  const batches = ORGANIC_BATCH_CONFIG;
  if (batches) {
    Logger.log('Batch count: ' + batches.length);
    Logger.log('Current human-readable batch: ' + (Math.min(batchIndex + 1, batches.length)) + '/' + batches.length);
  }

  if (startTime) {
    Logger.log('Started: ' + startTime);
    const elapsedMinutes = Math.round((new Date() - new Date(startTime)) / 1000 / 60);
    Logger.log('Elapsed minutes: ' + elapsedMinutes);
  }
  if (completedAt) {
    Logger.log('Last completed at: ' + completedAt);
  }

  const triggers = ScriptApp.getProjectTriggers().filter(function (t) {
    return t.getHandlerFunction() === ORGANIC_TRIGGER_HANDLER;
  });
  Logger.log('Active organic automation triggers: ' + triggers.length);
  Logger.log('===========================================================');
}


function deleteOrganicTriggers() {
  const triggers = ScriptApp.getProjectTriggers();
  let deleted = 0;
  triggers.forEach(function (trigger) {
    if (trigger.getHandlerFunction() === ORGANIC_TRIGGER_HANDLER) {
      ScriptApp.deleteTrigger(trigger);
      deleted++;
    }
  });
  if (deleted > 0) {
    Logger.log('Deleted ' + deleted + ' organic automation trigger(s).');
  }
}


// ==========================================================
// HELPER FUNCTIONS
// ==========================================================

function getOrCreateSheet_(ss, name) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
  }
  return sheet;
}

function initializeSheet_(sheet, headers) {
  if (sheet.getLastRow() === 0 || sheet.getRange(1, 1).getValue() !== headers[0]) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  }
}

function runTimestamp_() {
  return Utilities.formatDate(
    new Date(), 
    Session.getScriptTimeZone(), 
    'yyyy-MM-dd HH:mm:ss'
  );
}

function authHeader_() {
  // DFS_LOGIN and DFS_PASSWORD come from config.gs
  const auth = Utilities.base64Encode(DFS_LOGIN + ':' + DFS_PASSWORD);
  return { 'Authorization': 'Basic ' + auth };
}
