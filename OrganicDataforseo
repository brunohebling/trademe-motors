// ==========================================================
// CORE ENGINE: FETCH ORGANIC FOR A RANGE
// ==========================================================

/**
 * Main organic rankings function with batching and lock protection
 */
function fetchOrganicBatch(startRow, endRow, clearSheet) {
/* ─── config ────────────────────────────────────────── */
// LOCATION and LANGUAGE_CODE come from config.gs
const DELAY_MS = 1500;  // 2 seconds between each keyword
const ORG_URL  = 'https://api.dataforseo.com/v3/serp/google/organic/live/advanced';
/* ───────────────────────────────────────────────────── */

  const ss = SpreadsheetApp.getActive();
  if (!ss) {
    console.error('No active spreadsheet found');
    return;
  }
  
  const kwSheet  = getOrCreateSheet_(ss, 'Final keywords');
  const orgSheet = getOrCreateSheet_(ss, 'Organic');
  
  if (!kwSheet || !orgSheet) {
    console.error('Could not create/access required sheets');
    return;
  }

  // Check if we have enough keywords in the input sheet
  const lastInputRow = kwSheet.getLastRow();
  console.log(`Keywords sheet has ${lastInputRow} rows (including header)`);
  
  if (lastInputRow < 2) {
    console.error('No keywords found in "Final keywords" sheet. Please add keywords starting from row 2.');
    return;
  }
  
  if (startRow > lastInputRow) {
    console.log(`Start row ${startRow} exceeds available data (${lastInputRow}). Skipping.`);
    return;
  }

  // Adjust endRow if it exceeds available data
  const actualEndRow = Math.min(endRow, lastInputRow);
  const numRows = actualEndRow - startRow + 1;

  console.log(`Processing range: startRow=${startRow}, endRow=${endRow}, actualEndRow=${actualEndRow}, numRows=${numRows}`);

  if (numRows <= 0) {
    console.log(`No keywords to process in range ${startRow}-${endRow}`);
    return;
  }

  // Initialize headers and clear if first batch
 if (clearSheet) {
  try {
    initializeSheet_(orgSheet, ['Keyword', 'Position', 'URL', 'Timestamp', 'Source']);

    const lastRow = orgSheet.getLastRow();
    if (lastRow > 1) {
      const rowsToClear = lastRow - 1;
      orgSheet.getRange(2, 1, rowsToClear, 5).clearContent();
      console.log(`Cleared ${rowsToClear} existing organic rows`);
    }
  } catch (e) {
    console.error('Error clearing organic sheet: ' + e);
    return;
  }
}

  // Get keywords for this specific range
  let keywords = [];
  try {
    keywords = kwSheet
      .getRange(startRow, 1, numRows, 1)
      .getValues()
      .map(r => String(r[0] || '').trim())
      .filter(Boolean);
  } catch (e) {
    console.error(`Error reading keywords from range ${startRow}:${actualEndRow}: ${e.message}`);
    return;
  }

  if (keywords.length === 0) {
    console.log(`No valid keywords found in range ${startRow}-${actualEndRow}`);
    return;
  }

  const ts = runTimestamp_();
  const startTime = new Date();
  console.log(`Organic batch started (rows ${startRow}-${actualEndRow}): ${startTime.toISOString()}`);
  console.log(`Processing ${keywords.length} keywords with ${DELAY_MS}ms delay between requests`);

  // Auth header + content type
  const auth = authHeader_();
  const headers = Object.assign({ 'Content-Type': 'application/json' }, auth);

  const rows = [];
  const batchLabel = `Keywords-${startRow}-${actualEndRow}`;

  keywords.forEach((kw, index) => {
    const payload = [{
      keyword       : kw,
      location_name : LOCATION,
      language_code : LANGUAGE_CODE,
      device        : 'desktop',
      se_domain     : 'google.co.nz',
      depth         : 3,
      priority      : 2
    }];

    let items = [];
    try {
      const resp = UrlFetchApp.fetch(ORG_URL, {
        method             : 'post',
        muteHttpExceptions : true,
        headers            : headers,
        payload            : JSON.stringify(payload)
      });

      const code = resp.getResponseCode();
      if (code >= 200 && code < 300) {
        const j  = JSON.parse(resp.getContentText() || '{}');
        const t0 = (j.tasks && j.tasks[0]) ? j.tasks[0] : null;
        const r0 = (t0 && t0.result && t0.result[0]) ? t0.result[0] : null;
        items    = (r0 && Array.isArray(r0.items)) ? r0.items : [];
      } else {
        rows.push([kw, `ERR(${code})`, '', ts, batchLabel]);
        console.error(`HTTP ${code} for "${kw}"`);
      }
    } catch (e) {
      rows.push([kw, 'ERR', '', ts, batchLabel]);
      console.error(`Fetch error for "${kw}": ${e && e.message ? e.message : e}`);
    }

    // Up to 10 organic items per keyword
    let added = 0;
    for (const it of items) {
      if (it && it.type === 'organic' && added < 10) {
        rows.push([kw, it.rank_absolute, it.url || '', ts, batchLabel]);
        added++;
      }
    }
    if (added === 0) {
      rows.push([kw, '–', '', ts, batchLabel]);
    }

    // Rate limiting: delay between requests (skip on last keyword)
    if (index < keywords.length - 1) {
      Utilities.sleep(DELAY_MS);
    }
  });

  // Use lock when appending data
if (rows.length) {
  try {
    const writeRow = Math.max(orgSheet.getLastRow() + 1, 2);
    orgSheet.getRange(writeRow, 1, rows.length, 5).setValues(rows);
  } catch (e) {
    console.error('Error writing organic rows: ' + e);
    return;
  }
}

  const endTime = new Date();
  const duration = (endTime - startTime) / 1000;
  console.log(`Organic batch completed (rows ${startRow}-${actualEndRow}): ${endTime.toISOString()} | rows written: ${rows.length} | duration: ${duration}s`);
}


