function buildZenserpUrl(keyword, device) {
  return 'https://app.zenserp.com/api/v2/search?' +
    'apikey=' + encodeURIComponent(ZEN_CONFIG.apiKey) +
    '&q=' + encodeURIComponent(keyword) +
    '&location=' + encodeURIComponent(ZEN_CONFIG.location) +
    '&hl=' + encodeURIComponent(ZEN_CONFIG.hl) +
    '&device=' + encodeURIComponent(device);
}


function acquireLockAndWrite(lock, sheet, rows, clear) {
  var lockAcquired = false;

  try {
    lockAcquired = lock.tryLock(ZEN_CONFIG.lockTimeoutMs);

    if (!lockAcquired) {
      throw new Error('Could not acquire sheet lock after ' + ZEN_CONFIG.lockTimeoutMs + 'ms');
    }

    if (clear) {
      sheet.clear();
      if (rows.length > 0) {
        sheet.appendRow(rows[0]);
        if (rows.length > 1) {
          sheet.getRange(2, 1, rows.length - 1, rows[0].length).setValues(rows.slice(1));
        }
      }
    } else {
      if (rows.length > 0) {
        var nextRow = sheet.getLastRow() + 1;
        sheet.getRange(nextRow, 1, rows.length, rows[0].length).setValues(rows);
      }
    }

  } finally {
    if (lockAcquired) {
      lock.releaseLock();
    }
  }
}


function deleteZenserpBatchTriggers() {
  var triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(function(trigger) {
    if (trigger.getHandlerFunction() === ZEN_TRIGGER_HANDLER) {
      ScriptApp.deleteTrigger(trigger);
    }
  });
}


function stopZenserpAutomation() {
  var props = PropertiesService.getScriptProperties();
  props.setProperty('zenserpRunning', 'false');
  props.setProperty('zenserpStoppedReason', 'manual_' + new Date().toISOString());
  deleteZenserpBatchTriggers();
  Logger.log('Automation stopped.');
}


function forceResetAndRestart() {
  var props = PropertiesService.getScriptProperties();

  Logger.log('================ FORCE RESET ================');

  props.setProperty('zenserpRunning', 'false');
  props.deleteProperty('zenserpDevice');
  props.deleteProperty('zenserpBatchIndex');
  props.deleteProperty('zenserpStartTime');
  props.deleteProperty('zenserpRetryCount');

  deleteZenserpBatchTriggers();

  Logger.log('✓ State cleared.');
  Logger.log('Run startZenserpAutomation() to restart');
  Logger.log('Or wait for next scheduled run at ' + ZEN_CONFIG.fullAutomationHours.join(':00 or ') + ':00');
}


function forceResetAndStartNow() {
  forceResetAndRestart();
  Logger.log('Starting fresh automation now...');
  startZenserpAutomation();
}


function checkAllZenserpStatus() {
  var props = PropertiesService.getScriptProperties();

  Logger.log('================ ZENSERP AUTOMATION STATUS ================');
  Logger.log('Current time: ' + new Date().toISOString());
  Logger.log('');

  Logger.log('--- CONFIGURATION ---');
  Logger.log('Batch size: 50 keywords (timeout-safe)');
  Logger.log('Sleep per keyword: ' + ZEN_CONFIG.delayMs + 'ms');
  Logger.log('Max execution time: ' + (ZEN_CONFIG.maxExecutionTimeMs / 1000).toFixed(0) + 's');
  Logger.log('Scheduled runs: ' + ZEN_CONFIG.fullAutomationHours.join(':00, ') + ':00');
  Logger.log('');

  Logger.log('--- SCHEDULED TRIGGERS ---');
  var triggers = ScriptApp.getProjectTriggers();
  var dailyTriggers = triggers.filter(function(t) { return t.getHandlerFunction() === ZEN_DAILY_STARTER; });
  var batchTriggers = triggers.filter(function(t) { return t.getHandlerFunction() === ZEN_TRIGGER_HANDLER; });

  Logger.log('Daily full automation triggers: ' + dailyTriggers.length + ' (expected ' + ZEN_CONFIG.fullAutomationHours.length + ')');
  Logger.log('Active batch triggers: ' + batchTriggers.length);
  Logger.log('');

  Logger.log('--- FULL AUTOMATION ---');
  var running = props.getProperty('zenserpRunning') === 'true';
  Logger.log('Currently running: ' + (running ? 'YES' : 'NO'));

  if (running) {
    var device   = props.getProperty('zenserpDevice');
    var batchIdx = parseInt(props.getProperty('zenserpBatchIndex') || '0', 10);
    var startTime = props.getProperty('zenserpStartTime');

    Logger.log('Progress: ' + device + ' batch ' + (batchIdx + 1) + '/' + ZEN_BATCH_CONFIG.mobile.length);

    if (startTime) {
      var hoursElapsed = ((new Date() - new Date(startTime)) / (1000 * 60 * 60)).toFixed(1);
      Logger.log('Running for: ' + hoursElapsed + ' hours');
    }
  }

  var lastCompleted = props.getProperty('zenserpCompletedAt');
  if (lastCompleted) Logger.log('Last completed: ' + lastCompleted);

  var startupFailure = props.getProperty('zenserpStartupFailure');
  if (startupFailure) Logger.log('⚠️ Last startup failure: ' + startupFailure);

  Logger.log('');
  Logger.log('==========================================================');
}


function isAutomationHealthy() {
  var triggers = ScriptApp.getProjectTriggers();

  var dailyTriggerCount = triggers.filter(function(t) {
    return t.getHandlerFunction() === ZEN_DAILY_STARTER;
  }).length;

  var expectedTriggers = ZEN_CONFIG.fullAutomationHours.length;
  var healthy = dailyTriggerCount === expectedTriggers;

  Logger.log('Health check: ' + (healthy ? '✓ HEALTHY' : '✗ ISSUES'));
  Logger.log('Daily triggers: ' + dailyTriggerCount + '/' + expectedTriggers);

  if (!healthy) {
    Logger.log('Run setupFullyAutonomousSchedule() to fix.');
  }

  return healthy;
}
