function setupFullyAutonomousSchedule() {
  removeAllSchedules();

  Logger.log('================ SETTING UP AUTONOMOUS SCHEDULE ================');
  Logger.log('✓ Using 50-keyword batches to avoid timeout (360s limit)');
  Logger.log('✓ Full run scheduled TWICE daily');
  Logger.log('✓ Timeout detection: 5-minute limit per execution');
  Logger.log('');

  // Schedule full automation twice daily
  ZEN_CONFIG.fullAutomationHours.forEach(function(hour) {
    ScriptApp.newTrigger(ZEN_DAILY_STARTER)
      .timeBased()
      .everyDays(1)
      .atHour(hour)
      .nearMinute(0)
      .create();
    Logger.log('✓ Full automation scheduled for ' + hour + ':00 daily');
  });

  Logger.log('  → ' + ZEN_BATCH_CONFIG.mobile.length + ' batches × 2 devices per run');

  // Watchdog
  ScriptApp.newTrigger(ZEN_WATCHDOG)
    .timeBased()
    .everyHours(1)
    .create();

  Logger.log('✓ Watchdog scheduled every hour');
  Logger.log('');
  Logger.log('MATH CHECK:');
  Logger.log('- 50 keywords/batch × 100ms sleep = 5 seconds');
  Logger.log('- Leaves 325 seconds for API calls');
  Logger.log('- Average: 6.5s per request (safe buffer)');
  Logger.log('');
  Logger.log('All triggers created. System will run autonomously from tomorrow.');
  Logger.log('================================================================');
}


function removeAllSchedules() {
  var triggers = ScriptApp.getProjectTriggers();
  var deleted = 0;

  var handlersToRemove = [
    ZEN_TRIGGER_HANDLER,
    ZEN_DAILY_STARTER,
    ZEN_WATCHDOG
  ];

  triggers.forEach(function(trigger) {
    if (handlersToRemove.indexOf(trigger.getHandlerFunction()) !== -1) {
      ScriptApp.deleteTrigger(trigger);
      deleted++;
    }
  });

  Logger.log('Removed ' + deleted + ' trigger(s). All automation stopped.');

  var props = PropertiesService.getScriptProperties();
  props.setProperty('zenserpRunning', 'false');
  props.deleteProperty('zenserpRetryCount');
  props.deleteProperty('zenserpTriggerFailed');
}


