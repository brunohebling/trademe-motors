// WATCHDOG
// ==========================================================

function checkAbandonedFlags() {
  var props = PropertiesService.getScriptProperties();
  var running = props.getProperty('zenserpRunning') === 'true';

  if (!running) return;

  var startTime = props.getProperty('zenserpStartTime');

  if (!startTime || startTime.trim() === '') {
    Logger.log('⚠️ [WATCHDOG] Abandoned flag: running=true, no startTime. Clearing.');
    props.setProperty('zenserpRunning', 'false');
    props.setProperty('zenserpStoppedReason', 'watchdog_abandoned_' + new Date().toISOString());
    deleteZenserpBatchTriggers();
    return;
  }

  try {
    var startDate = new Date(startTime);

    if (isNaN(startDate.getTime())) {
      Logger.log('⚠️ [WATCHDOG] Invalid startTime. Clearing.');
      props.setProperty('zenserpRunning', 'false');
      props.setProperty('zenserpStoppedReason', 'watchdog_invalid_time_' + new Date().toISOString());
      deleteZenserpBatchTriggers();
      return;
    }

    var hoursElapsed = (new Date() - startDate) / (1000 * 60 * 60);

    if (hoursElapsed > ZEN_CONFIG.maxRunHours) {
      Logger.log('⚠️ [WATCHDOG] Stuck run (' + hoursElapsed.toFixed(1) + 'h). Clearing.');
      props.setProperty('zenserpRunning', 'false');
      props.setProperty('zenserpStoppedReason', 'watchdog_timeout_' + new Date().toISOString());
      deleteZenserpBatchTriggers();
    }

  } catch (e) {
    Logger.log('⚠️ [WATCHDOG] Error: ' + e.message + '. Clearing.');
    props.setProperty('zenserpRunning', 'false');
    deleteZenserpBatchTriggers();
  }
}


